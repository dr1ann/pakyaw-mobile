# Pakyaw — environment template. Copy to .env (development) or configure per-env.
# Public values are inlined at build via the EXPO_PUBLIC_ prefix; never put secrets here.

# App
APP_ENV=development
# Native Firebase app config is role-specific. Set these to files downloaded
# from the pakyaw-39434 Firebase project for the Driver app before prebuild.
EAS_PROJECT_ID=
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICES_PLIST=

# Firebase (web SDK config — public)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Test-only: set true only in development with the exact fictional number
# configured in Firebase Authentication > Phone > Phone numbers for testing.
EXPO_PUBLIC_PHONE_AUTH_TEST_MODE=false
EXPO_PUBLIC_PHONE_AUTH_TEST_NUMBER=
# Use the exact bucket shown in Firebase Console (for example project-id.firebasestorage.app).
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Google Maps (API key — restrict to Android package + iOS bundle in Google Cloud Console)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
