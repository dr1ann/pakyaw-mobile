# Pakyaw — environment template. Copy to .env (development) or configure per-env.
# Public values are inlined at build via the EXPO_PUBLIC_ prefix; never put secrets here.

# App
APP_ENV=development

# Firebase (web SDK config — public)
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Test-only: set true only with a fictional number configured in Firebase Authentication.
EXPO_PUBLIC_FIREBASE_AUTH_TEST_MODE=false

# Google Maps (API key — restrict to Android package + iOS bundle in Google Cloud Console)
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
