rules_version = '2';

// Phase 8A — Trip Lifecycle State Machine.
//
// Builds on Phase 7 (matching/acceptance). Adds forward-only trip status
// transitions enforced server-side via the same matrix as trip.service.ts:
//
//   accepted → driver_arriving → driver_arrived → in_progress → completed
//
// Cancel is allowed from accepted, driver_arriving, driver_arrived and writes
// status='cancelled' (the document is retained). A pre-acceptance 'request' is
// NOT cancelled by status write — the passenger DELETES it (abandoned request),
// see the trips delete rule below.
// Terminal states (completed, cancelled) reject all further writes.
// request → accepted remains Phase 7 only (its rule is preserved below).

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isDriver() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/drivers/$(request.auth.uid));
    }

    // ── users/{uid} ───────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow create: if isSignedIn() && request.auth.uid == uid;
      allow update, delete: if false;
    }

    // ── drivers/{uid} ─────────────────────────────────────────────────────
    // Phase 5: availability flip between 'offline' and 'online'.
    // Phase 7: online → on_trip with activeTripId set.
    // Phase 8A: on_trip → online with activeTripId=null (trip completed/cancelled).
    //           Also: tripCount increment on completion.
    // Phase 8C: passenger may read the driver doc when the driver's activeTripId
    //           points to a trip owned by the passenger (location subscription).
    match /drivers/{uid} {
      allow read: if isSignedIn() && (
        request.auth.uid == uid
        ||
        // Phase 8C: passenger reads driver location during active trip.
        // The driver's activeTripId must reference a trip whose passengerId
        // is the caller.
        (
          resource.data.activeTripId is string
          && exists(/databases/$(database)/documents/trips/$(resource.data.activeTripId))
          && get(/databases/$(database)/documents/trips/$(resource.data.activeTripId)).data.passengerId == request.auth.uid
        )
      );

      allow update: if isSignedIn()
        && (
          (
            request.auth.uid == uid
            && (
              // Phase 5: offline <-> online, activeTripId stays null.
              (
                request.resource.data.availability in ['offline', 'online']
                && (
                  !('activeTripId' in request.resource.data)
                  || request.resource.data.activeTripId == null
                )
              )
              ||
              // Phase 7: online -> on_trip with activeTripId set.
              (
                resource.data.availability == 'online'
                && (
                  !('activeTripId' in resource.data)
                  || resource.data.activeTripId == null
                )
                && request.resource.data.availability == 'on_trip'
                && request.resource.data.activeTripId is string
              )
              ||
              // Phase 7: location-only writes while on_trip. Availability and
              // activeTripId must remain unchanged.
              (
                resource.data.availability == 'on_trip'
                && request.resource.data.availability == resource.data.availability
                && request.resource.data.activeTripId == resource.data.activeTripId
                && !('tripCount' in request.resource.data.diff(resource.data).affectedKeys())
              )
              ||
              // Phase 8A: on_trip → online with activeTripId cleared (completion).
              // tripCount must increment by exactly 1.
              (
                resource.data.availability == 'on_trip'
                && request.resource.data.availability == 'online'
                && request.resource.data.activeTripId == null
                && request.resource.data.tripCount == resource.data.tripCount + 1
              )
              ||
              // Phase 8A: on_trip → online with activeTripId cleared (cancellation).
              // tripCount must NOT change.
              (
                resource.data.availability == 'on_trip'
                && request.resource.data.availability == 'online'
                && request.resource.data.activeTripId == null
                && request.resource.data.tripCount == resource.data.tripCount
              )
            )
          )
          ||
          // Passenger updating the driver doc during trip completion or cancellation.
          // They must be the passenger of the driver's active trip.
          (
            resource.data.activeTripId is string
            && exists(/databases/$(database)/documents/trips/$(resource.data.activeTripId))
            && get(/databases/$(database)/documents/trips/$(resource.data.activeTripId)).data.passengerId == request.auth.uid
            && request.resource.data.availability == 'online'
            && request.resource.data.activeTripId == null
            && (
              // Case A: Trip completed (tripCount increments)
              (request.resource.data.tripCount == resource.data.tripCount + 1)
              ||
              // Case B: Trip cancelled (tripCount stays the same)
              (request.resource.data.tripCount == resource.data.tripCount)
            )
          )
        );

      allow create, delete: if false;
    }

    // ── trips/{tripId} ────────────────────────────────────────────────────
    match /trips/{tripId} {
      // Drivers may read trips that are open requests, or trips already
      // assigned to them. Passengers (owners) may always read their own.
      allow read: if isSignedIn() && (
        request.auth.uid == resource.data.passengerId
        || (
          isDriver()
          && resource.data.status == 'request'
          && resource.data.driverId == null
        )
        || (
          isDriver()
          && resource.data.driverId == request.auth.uid
        )
      );

      // Passenger creates their own trip request.
      allow create: if isSignedIn()
        && request.resource.data.passengerId == request.auth.uid
        && request.resource.data.mode == 'solo'
        && request.resource.data.status == 'request'
        && request.resource.data.driverId == null
        && request.resource.data.serviceAreaId == 'ormoc'
        // Service area (Ormoc bounds) on coords.lat/lng
        && request.resource.data.pickup.coords.lat >= 10.9
        && request.resource.data.pickup.coords.lat <= 11.11
        && request.resource.data.pickup.coords.lng >= 124.49
        && request.resource.data.pickup.coords.lng <= 124.72
        && request.resource.data.destination.coords.lat >= 10.9
        && request.resource.data.destination.coords.lat <= 11.11
        && request.resource.data.destination.coords.lng >= 124.49
        && request.resource.data.destination.coords.lng <= 124.72
        // Distance plausibility (sanity bound)
        && request.resource.data.route.distanceMeters >= 50
        && request.resource.data.route.distanceMeters <= 60000;

      allow update: if isSignedIn() && (
        // ── Phase 7: accept (request → accepted) ──────────────────────────
        // Driver claims an open request.
        (
          isDriver()
          && resource.data.passengerId != request.auth.uid
          && resource.data.status == 'request'
          && resource.data.driverId == null
          && request.resource.data.driverId == request.auth.uid
          && request.resource.data.status == 'accepted'
          && request.resource.data.acceptedAt == request.time
          && request.resource.data.passengerId == resource.data.passengerId
          && request.resource.data.pickup == resource.data.pickup
          && request.resource.data.destination == resource.data.destination
          && request.resource.data.passengerCount == resource.data.passengerCount
          && request.resource.data.billedSeats == resource.data.billedSeats
          && request.resource.data.geohash == resource.data.geohash
          && request.resource.data.route == resource.data.route
          && request.resource.data.serviceAreaId == resource.data.serviceAreaId
          // driverRoute (Phase 12) / driverToPickup (legacy) are optional. The
          // accept write never sets them; only enforce they are unchanged when
          // already present. Both names are tolerated so trips created by either
          // an older app build (driverToPickup) or the current build remain
          // acceptable during the migration window.
          && (!('driverRoute' in request.resource.data) || request.resource.data.driverRoute == resource.data.driverRoute)
          && (!('driverToPickup' in request.resource.data) || request.resource.data.driverToPickup == resource.data.driverToPickup)
          && request.resource.data.keys().hasOnly([
               'passengerId', 'pickup', 'destination', 'passengerCount',
               'billedSeats', 'geohash', 'status', 'driverId', 'acceptedAt',
               'requestedAt', 'mode', 'route', 'serviceAreaId', 'driverRoute', 'driverToPickup'
             ])
        )
        ||
        // ── Phase 12: driverRoute live updates ────────────────────────────
        // Only the assigned driver may update driverRoute, and only while
        // status is accepted, driver_arriving, or in_progress. Publishing
        // during in_progress lets the passenger see the same live navigation
        // route the driver is following, matching Grab / Uber behavior.
        (
          isDriver()
          && resource.data.driverId == request.auth.uid
          && resource.data.status in ['accepted', 'driver_arriving', 'in_progress']
          && request.resource.data.driverRoute != null
          && request.resource.data.driverRoute.distanceMeters is number
          && request.resource.data.driverRoute.durationSeconds is number
          && request.resource.data.driverRoute.polyline is string
          && request.resource.data.driverRoute.polyline.size() <= 8192
          // Enforce all other fields are unchanged
          && request.resource.data.status == resource.data.status
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.passengerId == resource.data.passengerId
          && request.resource.data.pickup == resource.data.pickup
          && request.resource.data.destination == resource.data.destination
          && request.resource.data.passengerCount == resource.data.passengerCount
          && request.resource.data.billedSeats == resource.data.billedSeats
          && request.resource.data.geohash == resource.data.geohash
          && request.resource.data.requestedAt == resource.data.requestedAt
          && request.resource.data.mode == resource.data.mode
          && request.resource.data.route == resource.data.route
          && request.resource.data.serviceAreaId == resource.data.serviceAreaId
        )
        ||
        // ── Phase 4: lightweight passenger live progress ──────────────────
        // Only the assigned driver may publish the compact progress object.
        // The full route is never accepted by this write path.
        (
          isDriver()
          && resource.data.driverId == request.auth.uid
          && resource.data.status in ['driver_arriving', 'in_progress']
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tripProgress'])
          && request.resource.data.tripProgress.keys().hasOnly([
               'remainingMeters', 'etaSeconds', 'updatedAt'
             ])
          && request.resource.data.tripProgress.remainingMeters is number
          && request.resource.data.tripProgress.remainingMeters >= 0
          && request.resource.data.tripProgress.etaSeconds is number
          && request.resource.data.tripProgress.etaSeconds >= 0
          && request.resource.data.tripProgress.updatedAt == request.time
        )
        ||
        // ── Phase 8A: accepted → driver_arriving ──────────────────────────
        (
          isDriver()
          && resource.data.driverId == request.auth.uid
          && resource.data.status == 'accepted'
          && request.resource.data.status == 'driver_arriving'
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.passengerId == resource.data.passengerId
        )
        ||
        // ── Phase 8A: driver_arriving → driver_arrived ────────────────────
        (
          isDriver()
          && resource.data.driverId == request.auth.uid
          && resource.data.status == 'driver_arriving'
          && request.resource.data.status == 'driver_arrived'
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.passengerId == resource.data.passengerId
        )
        ||
        // ── Phase 8A: driver_arrived → in_progress ────────────────────────
        (
          isDriver()
          && resource.data.driverId == request.auth.uid
          && resource.data.status == 'driver_arrived'
          && request.resource.data.status == 'in_progress'
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.passengerId == resource.data.passengerId
        )
        ||
        // ── Phase 8A: in_progress → completed ─────────────────────────────
        (
          (
            (isDriver() && resource.data.driverId == request.auth.uid)
            ||
            (request.auth.uid == resource.data.passengerId)
          )
          && resource.data.status == 'in_progress'
          && request.resource.data.status == 'completed'
          && request.resource.data.completedAt == request.time
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.passengerId == resource.data.passengerId
        )
        ||
        // ── Phase 8A: cancel (by driver) ──────────────────────────────────
        // Only from accepted, driver_arriving, driver_arrived.
        (
          isDriver()
          && resource.data.driverId == request.auth.uid
          && resource.data.status in ['accepted', 'driver_arriving', 'driver_arrived']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.cancelledBy == 'driver'
          && request.resource.data.cancelReason is string
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.passengerId == resource.data.passengerId
        )
        ||
        // ── Phase 8A: cancel (by passenger) ───────────────────────────────
        // Only from accepted, driver_arriving, driver_arrived. A 'request' is
        // not cancelled via status write — it is deleted (see delete rule).
        (
          request.auth.uid == resource.data.passengerId
          && resource.data.status in ['accepted', 'driver_arriving', 'driver_arrived']
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelledAt == request.time
          && request.resource.data.cancelledBy == 'passenger'
          && request.resource.data.cancelReason is string
          && request.resource.data.driverId == resource.data.driverId
          && request.resource.data.passengerId == resource.data.passengerId
        )
      );

      // Pre-acceptance abandonment: the owning passenger may delete their own
      // trip while it is still an open 'request' with no driver assigned. This
      // is the only delete permitted; after acceptance a trip is cancelled via
      // a status write and retained for history.
      allow delete: if isSignedIn()
        && request.auth.uid == resource.data.passengerId
        && resource.data.status == 'request'
        && resource.data.driverId == null;
    }

    // Default deny for everything else until later phases extend.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
